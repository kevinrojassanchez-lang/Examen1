<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.proyecto.controller.ConsultaController"
            prefWidth="900" prefHeight="560">

    <top>
        <VBox spacing="6" style="-fx-background-color: #17324D;">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>
            <Label text="CONSULTA DE CITAS"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Consulte las citas registradas en el sistema."
                   style="-fx-font-size: 14px; -fx-text-fill: #DCE6F1;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <TableView fx:id="tablaCitas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="160"/>
                    <TableColumn fx:id="colProfesional" text="Profesional" prefWidth="160"/>
                    <TableColumn fx:id="colServicio" text="Servicio" prefWidth="150"/>
                    <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="170"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                </columns>
            </TableView>

            <HBox spacing="12">
                <Button text="Actualizar"
                        onAction="#actualizarTabla"
                        prefWidth="120"/>
                <Button text="Volver al menú"
                        onAction="#volverMenu"
                        prefWidth="140"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>

