<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.proyecto.controller.GestionController"
            prefWidth="900" prefHeight="620">

    <top>
        <VBox spacing="6" style="-fx-background-color: #17324D;">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>
            <Label text="GESTIÓN DE CITAS"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Cancelar, reprogramar o actualizar el estado de una cita."
                   style="-fx-font-size: 14px; -fx-text-fill: #DCE6F1;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <TableView fx:id="tablaCitas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180"/>
                    <TableColumn fx:id="colProfesional" text="Profesional" prefWidth="180"/>
                    <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="220"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="150"/>
                </columns>
            </TableView>

            <Label text="Reprogramar cita seleccionada"
                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <DatePicker fx:id="dpNuevaFecha" promptText="Nueva fecha"/>
                <TextField fx:id="txtNuevaHora"
                           promptText="Hora HH:mm"
                           prefWidth="120"/>
                <Button text="Reprogramar"
                        onAction="#reprogramarCita"/>
            </HBox>

            <Label text="Cambiar estado de la cita seleccionada"
                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="cmbEstado"
                          promptText="Seleccione estado"
                          prefWidth="200"/>
                <Button text="Aplicar estado"
                        onAction="#cambiarEstado"/>
                <Button text="Cancelar cita"
                        onAction="#cancelarCita"
                        style="-fx-background-color: #B83A3A; -fx-text-fill: white;"/>
            </HBox>

            <HBox spacing="10">
                <Button text="Actualizar tabla"
                        onAction="#actualizarTabla"/>
                <Button text="Volver al menú"
                        onAction="#volverMenu"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
