<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.proyecto.controller.PrincipalController"
            prefWidth="800" prefHeight="500">

    <top>
        <VBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-background-color: #17324D;">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            <Label text="SISTEMA DE GESTIÓN DE CITAS"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Programación II | Examen Práctico Integrador"
                   style="-fx-font-size: 14px; -fx-text-fill: #DCE6F1;"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="22">
            <padding>
                <Insets top="30" right="25" bottom="30" left="25"/>
            </padding>

            <Label text="Menú principal"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Seleccione la operación que desea realizar."
                   style="-fx-font-size: 14px;"/>

            <HBox alignment="CENTER" spacing="15">
                <Button text="Registrar cita"
                        onAction="#irARegistro"
                        prefWidth="160" prefHeight="55"
                        style="-fx-background-color: #2463A6; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Consultar citas"
                        onAction="#irAConsulta"
                        prefWidth="160" prefHeight="55"
                        style="-fx-background-color: #247A61; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Gestionar citas"
                        onAction="#irAGestion"
                        prefWidth="160" prefHeight="55"
                        style="-fx-background-color: #B56A24; -fx-text-fill: white; -fx-font-size: 14px;"/>
            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #EAF0F6;">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label fx:id="lblEstado"
                   style="-fx-font-size: 12px; -fx-text-fill: #17324D;"/>
        </HBox>
    </bottom>

</BorderPane>