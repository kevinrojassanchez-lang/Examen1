<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.proyecto.controller.RegistroController"
            prefWidth="800" prefHeight="560">

    <top>
        <VBox spacing="6" style="-fx-background-color: #17324D;">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>
            <Label text="REGISTRO DE CITAS"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Complete los datos para programar una cita."
                   style="-fx-font-size: 14px; -fx-text-fill: #DCE6F1;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="25" right="40" bottom="25" left="40"/>
            </padding>

            <GridPane hgap="15" vgap="15">
                <Label text="Identificación del cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtIdentificacionCliente"
                           promptText="Identificación"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Nombre del cliente:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNombreCliente"
                           promptText="Nombre completo"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtTelefono"
                           promptText="Teléfono"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtCorreo"
                           promptText="correo@ejemplo.com"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Profesional:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="cmbProfesional"
                          promptText="Seleccione profesional"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Servicio:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <ComboBox fx:id="cmbServicio"
                          promptText="Seleccione servicio"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <DatePicker fx:id="dpFecha"
                            promptText="Seleccione fecha"
                            maxWidth="Infinity"
                            GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Hora (HH:mm):" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <TextField fx:id="txtHora"
                           promptText="Ejemplo: 14:30"
                           GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            </GridPane>

            <Label fx:id="lblMensaje"
                   wrapText="true"
                   style="-fx-font-size: 13px;"/>

            <HBox spacing="12">
                <Button text="Guardar cita"
                        onAction="#guardarCita"
                        prefWidth="140"
                        style="-fx-background-color: #247A61; -fx-text-fill: white;"/>
                <Button text="Volver al menú"
                        onAction="#volverMenu"
                        prefWidth="140"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>

